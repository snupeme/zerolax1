# ---------------------------------------------------------------------------
# ZEROLAX environment configuration
# Copy this file to .env and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Public URL of the web app (used for CORS and Telegram WebApp buttons)
WEB_URL=http://localhost:5173
# Base URL of the API used by the bot and the Vite dev proxy
API_URL=http://localhost:4000
# Base URL the browser uses to reach the API. Leave empty to use same-origin
# requests (recommended: Vite/Nginx proxies /api and /health).
VITE_API_URL=
# Comma separated list of extra allowed origins
CORS_ORIGINS=

# Database -------------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database (local dev only).
# For production/Supabase use the Postgres connection string, e.g.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=
# Set to "true" when the Postgres server requires SSL (Supabase does)
DATABASE_SSL=false
# Directory for the embedded PGlite database when DATABASE_URL is empty
PGLITE_DIR=.data/zerolax

# Auth -----------------------------------------------------------------------
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Development-only login (disabled automatically in production)
DEV_AUTH_ENABLED=true

# Telegram -------------------------------------------------------------------
# Get the token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @
TELEGRAM_BOT_USERNAME=ZerolaxBot
# Public HTTPS URL of the Mini App (must be HTTPS for Telegram)
TELEGRAM_WEBAPP_URL=
# Reject initData older than this many seconds
TELEGRAM_AUTH_MAX_AGE_SECONDS=300

# Admin bootstrap ------------------------------------------------------------
# The admin is created automatically on first API start when both values are set.
ADMIN_EMAIL=admin@zerolax.uz
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=ZEROLAX Admin

# Misc -----------------------------------------------------------------------
TZ=Asia/Tashkent
LOG_LEVEL=info
# Shown on the Support screen and used by the bot's support command
SUPPORT_EMAIL=support@zerolax.uz
## Optional Unicode font for generated learning certificates (auto-detects Arial/DejaVu).
# CERTIFICATE_FONT_PATH=C:/Windows/Fonts/arial.ttf
