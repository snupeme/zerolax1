    "@zerolax/shared": "*",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "tsup": "^8.5.0",
